# Canonical origin used for metadata, sitemap and hreflang URLs.
# Set this to the real production origin before deploying.
NEXT_PUBLIC_SITE_URL=https://extensionprivacychecker.top

# Optional search-engine verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Allow reputable search and AI crawlers in robots.txt (true/false).
ALLOW_AI_CRAWLERS=true

# Optional: comma-separated additional crawler user agents to allow.
ALLOWED_CRAWLERS=
